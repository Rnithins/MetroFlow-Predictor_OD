APP_NAME=MetroFlowNet API
API_PREFIX=/api/v1
SECRET_KEY=change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=180
MONGODB_URI=mongomock://localhost
MONGODB_DATABASE=metroflow_predictor
CORS_ORIGINS=http://localhost:3000
MODEL_VERSION=metroflow-adaptive-fusion-v2
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
OTD_DELHI_API_KEY=your_otd_delhi_api_key_here
POSTGRES_URI=postgresql://metro_user:metro_pass@localhost:5432/metroflownet
REDIS_URL=redis://localhost:6379/0
